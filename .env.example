# Portal that hosts the SAP WebDynpro job search application
PORTAL_URL=https://ep.iitb.ac.in/jobsearch

# Cron expression for the daily fetch (default: every day at 06:00 local time)
SCRAPE_CRON=0 6 * * *

# Never fetch again if a successful run finished more recently than this (hours)
SCRAPE_MIN_INTERVAL_HOURS=24

# Run the automated scraper with a headless browser (set false to watch it)
HEADLESS=true

# Maximum pages of job listings to walk per run (safety cap)
SCRAPE_MAX_PAGES=50

# Delay between page/row actions in milliseconds (be polite to the portal)
SCRAPE_THROTTLE_MS=800

# Capture full job descriptions (PDF advert) for each posting. Cached JDs are reused.
SCRAPE_DETAILS=true

# Ignore the JD cache and re-download every advert (also available as --refresh-details)
SCRAPE_REFRESH_DETAILS=false

# Parallel detail-capture workers (1-5; 3 is a safe default)
SCRAPE_DETAIL_CONCURRENCY=3

# Reuse a cached JD for this many hours before refreshing it (0 = never expire)
SCRAPE_JD_REFRESH_HOURS=168

# Per-JD download/extraction timeout budget (milliseconds)
SCRAPE_DETAIL_TIMEOUT_MS=20000

# Retry a failed JD capture this many times before marking it failed
SCRAPE_DETAIL_RETRIES=1

# Store downloaded advert PDFs under db/jd for re-extraction/debugging
SCRAPE_STORE_PDFS=true

# OCR fallback for scanned or low-quality advert PDFs
OCR_ENABLED=true
OCR_LANG=eng
OCR_MIN_CHARS_PER_PAGE=40
OCR_SCALE=2

# Optional paths for OCR cache, stored PDFs, and raw debugging output
# OCR_CACHE_DIR=C:\Users\Mahesh\Desktop\My Jobs Search App\db\tesseract-cache
# JD_PDF_DIR=C:\Users\Mahesh\Desktop\My Jobs Search App\db\jd
# RAW_DIR=C:\Users\Mahesh\Desktop\My Jobs Search App\db\raw

# Playwright browser channel: chrome, msedge, or empty for bundled Chromium
PW_CHANNEL=chrome

# Save XHR/fetch responses under db/raw for debugging (leave false normally)
SCRAPE_CAPTURE_NETWORK=false

# Absolute path to the SQLite database file (optional; defaults to ./db/jobs.db)
# DATABASE_PATH=C:\Users\Mahesh\Desktop\My Jobs Search App\db\jobs.db
